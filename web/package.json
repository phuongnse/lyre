    "@fontsource/roboto": "5.3.0",
    "mediabunny": "1.61.4",
    "onnxruntime-web": "1.30.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.2",
    "@angular/cli": "22.2.2",
    "@angular/compiler-cli": "22.2.2",
